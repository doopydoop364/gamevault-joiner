# Origin HTTP stays on loopback. Cloudflare terminates public TLS.
worker_processes 1;
events {}
http {
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    map $http_upgrade $upgrade_connection { default upgrade; '' ''; }
    map $uri $login_key { default ""; ~*^/api/auth/basic/login/?$ $binary_remote_addr; }
    limit_req_zone $login_key zone=login:10m rate=12r/m;
    log_format minimal '$remote_addr $request_method $status $body_bytes_sent $request_time';
    access_log /dev/stdout minimal;
    server { listen 127.0.0.1:18080 default_server; return 404; }
    server {
        listen 127.0.0.1:18080;
        server_name gamevault.pcenthusiast.blog;
        if ($http_x_forwarded_proto = http) { return 308 https://gamevault.pcenthusiast.blog$request_uri; }
        limit_req zone=login burst=8 nodelay;
        limit_req_status 429;
        limit_req_log_level notice;
        location ~* ^/api/docs(?:/|-(?:json|yaml)$|$) { return 404; }
        location / {
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Forwarded "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $upgrade_connection;
            proxy_buffering off;
            proxy_read_timeout 120s;
            add_header Cache-Control "private, no-store" always;
        }
    }
}
