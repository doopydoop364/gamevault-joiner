# Review alongside the existing virtual host. Include in nginx's http context.
# Replace the certificate paths and upstream with reviewed deployment values.
map $http_upgrade $gamevault_connection {
    default upgrade;
    ''      '';
}

# Backend 17.0.1 uses basic authentication at this route. Empty keys skip
# this zone so bulk downloads, token refresh, and Web UI requests are unaffected.
map $uri $gamevault_login_key {
    default "";
    ~*^/api/auth/basic/login/?$ $binary_remote_addr;
}
limit_req_zone $gamevault_login_key zone=gamevault_login:10m rate=12r/m;
log_format gamevault_status '$remote_addr $request_method $status $body_bytes_sent $request_time';

server {
    listen 443 ssl;
    server_name gamevault.pcenthusiast.blog;

    ssl_certificate     /etc/ssl/gamevault/fullchain.pem;
    ssl_certificate_key /etc/ssl/gamevault/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    limit_req zone=gamevault_login burst=8 nodelay;
    limit_req_status 429;
    limit_req_log_level notice;
    access_log /var/log/nginx/gamevault-access.log gamevault_status;

    # Public API documentation is optional. Confirm against the installed version.
    location = /api/docs { return 404; }
    location ^~ /api/docs/ { return 404; }
    location = /api/docs-json { return 404; }
    location = /api/docs-yaml { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $gamevault_connection;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
